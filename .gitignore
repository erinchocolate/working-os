# 过程材料只存本地；个人判断库可随仓库保存。
worklog/*
!worklog/.gitkeep

# 任务笔记默认跟踪；本地实验附件不可进入 Git
tasks/.local/
tasks/**/.local/

# style/：profile 可进入个人 repo；样本默认保留本地
style/*
!style/*-profile.md
!style/english-samples/
!style/sharing-samples/
style/english-samples/*
!style/english-samples/.gitkeep
style/sharing-samples/*
!style/sharing-samples/.gitkeep

# sharing/：个人分享稿和 talk track 默认仅本地保存；GitHub 只保留目录结构
sharing/*
!sharing/.gitkeep

# 杂项
*.local.md
.DS_Store
idea.md
